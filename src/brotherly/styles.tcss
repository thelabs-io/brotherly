/* ── Brotherly TUI ── */
/* Layout only — colors come from the active theme */

/* ── Task List ── */

#task-container {
    padding: 1 2;
}

#empty-wrapper {
    height: 100%;
    align: center middle;
}

.empty-state {
    text-align: center;
    padding: 2 4;
}

#task-list {
    padding: 0;
}

TaskListItem {
    padding: 1 2;
    margin: 0 0 1 0;
    height: auto;
}

.task-title {
    text-style: bold;
    margin-bottom: 0;
}

.task-desc {
    margin: 0;
}

.task-meta {
    margin-top: 0;
}

/* ── Task Detail ── */

#detail-scroll {
    padding: 1 3;
}

.detail-title {
    text-style: bold;
    margin-bottom: 1;
    text-align: center;
}

.detail-meta {
    text-align: center;
    margin-bottom: 1;
}

#detail-description {
    margin: 1 2;
    padding: 1 2;
}

.spacer {
    height: 1;
}

.button-row {
    margin: 1 0;
    height: auto;
}

.buttons {
    width: auto;
    height: auto;
}

.buttons Button {
    margin: 0 1;
}

/* ── Source / Log View ── */

.source-header {
    padding: 1 2;
}

#source-scroll {
    padding: 1 2;
}

#source-code {
    padding: 1;
}

/* ── Summary ── */

#summary-scroll {
    padding: 1 3;
}

.summary-banner {
    text-align: center;
    margin: 1 4;
    padding: 1 2;
}

.summary-banner-success {
    text-style: bold reverse;
    color: $success;
}

.summary-banner-fail {
    text-style: bold reverse;
    color: $error;
}

.summary-title {
    text-align: center;
    margin: 1 0;
}

.summary-meta {
    text-align: center;
}

.summary-label {
    margin: 0 2;
}

.log-tail {
    margin: 0 2;
    padding: 1 2;
}

.summary-notify {
    text-align: center;
}
