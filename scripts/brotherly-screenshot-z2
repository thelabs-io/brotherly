#!/usr/bin/env python3
"""Capture the z2 desktop to a PNG (best-effort), for the watched-session demo.

z2 runs GNOME/Wayland, where `grim` is a no-op (it needs the wlroots screencopy
protocol, which Mutter does not implement) and `org.gnome.Shell.Screenshot` is
locked down ("Screenshot is not allowed") for non-interactive callers. The
supported CLI path on GNOME is the xdg-desktop-portal Screenshot API, driven
here via PyGObject. Falls back to `grim` for wlroots compositors (sway/Hyprland).

Usage: brotherly-screenshot-z2 <dest.png>
Exit 0 iff a non-empty screenshot was written to <dest>, else 1.
"""
import os
import shutil
import subprocess
import sys
import urllib.parse


def via_portal(dest):
    """xdg-desktop-portal Screenshot (GNOME/Wayland). May show a one-time allow
    dialog; bounded so an unanswered dialog can't hang the caller."""
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio, GLib
    except Exception:
        return False
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    except Exception:
        return False

    token = "brotherly_shot"
    sender = bus.get_unique_name()[1:].replace(".", "_")
    request_path = f"/org/freedesktop/portal/desktop/request/{sender}/{token}"
    loop = GLib.MainLoop()
    state = {"uri": None, "code": None}

    def on_response(_c, _s, _o, _i, _sig, params):
        code, results = params.unpack()
        state["code"] = code
        if code == 0:
            state["uri"] = results.get("uri")
        loop.quit()

    bus.signal_subscribe(
        "org.freedesktop.portal.Desktop",
        "org.freedesktop.portal.Request",
        "Response",
        request_path,
        None,
        Gio.DBusSignalFlags.NONE,
        on_response,
    )

    options = {
        "handle_token": GLib.Variant("s", token),
        "interactive": GLib.Variant("b", False),
    }
    try:
        bus.call_sync(
            "org.freedesktop.portal.Desktop",
            "/org/freedesktop/portal/desktop",
            "org.freedesktop.portal.Screenshot",
            "Screenshot",
            GLib.Variant("(sa{sv})", ("", options)),
            GLib.VariantType("(o)"),
            Gio.DBusCallFlags.NONE,
            -1,
            None,
        )
    except Exception:
        return False

    def on_timeout():
        if state["code"] is None:
            state["code"] = -1
        loop.quit()
        return False

    GLib.timeout_add_seconds(30, on_timeout)
    loop.run()

    if state["code"] != 0 or not state["uri"]:
        return False
    src = urllib.parse.unquote(urllib.parse.urlparse(state["uri"]).path)
    try:
        shutil.copyfile(src, dest)
        return os.path.getsize(dest) > 0
    except OSError:
        return False


def via_grim(dest):
    """grim works only on wlroots compositors (sway/Hyprland)."""
    if not shutil.which("grim"):
        return False
    try:
        subprocess.run(
            ["grim", dest],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return os.path.getsize(dest) > 0
    except (subprocess.CalledProcessError, OSError):
        return False


def main():
    if len(sys.argv) != 2:
        print("usage: brotherly-screenshot-z2 <dest.png>", file=sys.stderr)
        return 2
    dest = sys.argv[1]
    os.makedirs(os.path.dirname(os.path.abspath(dest)), exist_ok=True)
    if via_portal(dest) or via_grim(dest):
        print(dest)
        return 0
    print("no working z2 screenshot method (tried portal + grim)", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
